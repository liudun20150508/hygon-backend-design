# Gold reference: RTL -> gate-level ($_*_ cells), mirrors synth up to abc
read_liberty -lib skywater-pdk/libraries/sky130_fd_sc_hd/sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog picorv32/picorv32.v
hierarchy -check -top picorv32
proc
flatten
opt_expr
opt_clean
check
opt -nodffe -nosdff
fsm
opt
wreduce
peepopt
opt_clean
alumacc
share
opt
memory -nomap
opt_clean
opt -fast -full
memory_map
opt -full
techmap -map +/techmap.v
opt -fast
abc
opt -fast
# LEC requires both sides mapped to same cell set: map flops to liberty
# cells too, so gold and gate share identical edfxtp/dfxtp structure
dfflibmap -liberty skywater-pdk/libraries/sky130_fd_sc_hd/sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog /tmp/gold_raw.v
